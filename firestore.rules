# ============================================================
# firestore.rules
# Firestore Security Rules for BMN Application
# Paste this content into Firebase Console > Firestore > Rules
# ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: check if current user is admin ─────────────
    function isAdmin() {
      let email = request.auth.token.email.lower();
      return get(/databases/$(database)/documents/users/$(email)).data.role == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── users collection ───────────────────────────────────
    // - Admin: full read/write/delete
    // - User: read own document only, no write
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.token.email.lower() == userId || isAdmin());
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ─── barang collection ──────────────────────────────────
    // - All authenticated: read and write (update stok)
    // - Delete: admin only
    match /barang/{barcodeId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ─── transaksi collection ────────────────────────────────
    // - All authenticated: read and create
    // - Delete: admin only
    match /transaksi/{transaksiId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }
  }
}
